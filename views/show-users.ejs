<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Users</title>
    <style>
        table, tr, td, th{
            border: 2px, solid black;
        }
    </style>
</head>
<body>
    <table>
        <tr>
            <th>ID</th>
            <th>Username</th>
            <th>Email</th>
        </tr>
  
            <% for(user of users){%>
                <tr>
            <td><%= user.id%></td>
            <td><%= user.username%></td>
            <td><%= user.email%></td>
            <td>
            <form action="/user/<%= user.id%>/edit" method="get">
                <button>EDIT</button>
            </form>
            </td>
            <td>
            <form action="/user/<%= user.id%>?__method=DELETE" method="post">
                <button>DELETE</button>
            </form>
            </td>
        </tr>
            <% }%>
    </table>
    <form method="get" action="/user/add">
        <label for="btn" >Add a new user</label>
        <button name="btn" type="submit">Add</button>
    </form>
</body>
</html>